flowchart LR
    subgraph Interface["User Interface"]
        Human["Human Player"]
        UI["Streamlit UI\n(app.py)"]
        State[("Session State\nsecret, attempts, score,\nstatus, history, difficulty")]
        Human -->|"1. Guess or click New Game"| UI
        UI <-->|"2. Read and save game state"| State
    end

    subgraph Processing["Application Processing"]
        Range["Range Component\nget_range_for_difficulty"]
        Parser["Input Processor\nparse_guess"]
        Evaluator["Result Evaluator\ncheck_guess"]
        Scorer["Score Calculator\nupdate_score"]
        Commentary["Optional Commentary\nai_commentary.py"]

        UI -->|"3. Chosen difficulty"| Range
        Range -->|"Number range"| UI
        UI -->|"4. Raw guess text"| Parser
        Parser -->|"Valid guess or error"| UI
        UI -->|"Guess and secret"| Evaluator
        Evaluator -->|"Outcome and hint"| UI
        UI -->|"Outcome and attempt number"| Scorer
        Scorer -->|"Updated score"| UI
        UI -->|"Guess, difficulty, attempt,\nauthoritative outcome only"| Commentary
        Commentary -->|"Prompt excludes secret"| OpenAI["OpenAI Responses API\nmodel from OPENAI_MODEL"]
        OpenAI -->|"Variable commentary"| UI
        Commentary -->|"Visible error on failure"| UI
    end

    subgraph Verification["Testing and AI Result Checking"]
        HumanCheck["Human Reviewer"]
        AIAssistant["AI Assistant\nCandidate fixes and suggestions"]
        Pytest["Tester\npytest suite"]
        Demo["Example Runner\ndemo.py"]
        Evidence[("Reproducible Evidence\nassets/test-output.txt\nassets/demo-output.txt")]

        AIAssistant -->|"Draft fix or explanation"| HumanCheck
        HumanCheck -->|"Accept, reject, or revise suggestion"| Processing
        HumanCheck -->|"Review behavior and test failures"| Pytest
        HumanCheck -->|"Inspect example interactions"| Demo
        Range -.->|"Test range cases"| Pytest
        Parser -.->|"Test valid and invalid input"| Pytest
        Evaluator -.->|"Test hints and win/loss"| Pytest
        Scorer -.->|"Test score updates"| Pytest
        Commentary -.->|"Mocked API success and failures"| Pytest
        Demo -->|"Fixed guess examples"| Evaluator
        Pytest -->|"Test report"| Evidence
        Demo -->|"Interaction log"| Evidence
    end

    UI -->|"5. Hint, win/loss message, score"| Human
    UI -->|"Optional AI-generated commentary"| Human
